.env

# Python bytecode
__pycache__/
*.pyc

# Generated output (fully regenerated by running main.py)
output/

# Client report exports -- per-run input data, not part of the codebase
input/*
!input/.gitkeep
logs/*
!logs/.gitkeep

# PowerPoint files (working/legacy templates + generated decks) -- never tracked
*.pptx

# Misc generated/debug artifacts
Objects.txt
QBR_Structure.docx
